--- !u!114 &1162127458
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1162127457}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: e15628c87f2fa3c4284f1e17f17886a6, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  descriptionField: {fileID: 335874983}
  infoDescription: "Me llamo Clara Campoamor y nac\xED en Madrid en 1888, en una
    familia humilde. Perd\xED a mi padre siendo ni\xF1a y trabaj\xE9 desde muy joven
    como modista, dependienta y telefonista para ayudar en casa.\r\nCon esfuerzo,
    logr\xE9 obtener una plaza en Tel\xE9grafos, y m\xE1s tarde, a los 26 a\xF1os,
    me convert\xED en profesora de mecanograf\xEDa.\r\n Fue entonces cuando descubr\xED
    los c\xEDrculos intelectuales de Madrid y conoc\xED a muchas mujeres que sufr\xEDan
    enormes injusticias por el hecho de ser mujeres.\r\nA los 36 a\xF1os consegu\xED
    licenciarme en Derecho, convirti\xE9ndome en una de las primeras abogadas de
    Espa\xF1a. Pronto ejerc\xED mi profesi\xF3n y fui la primera mujer en hablar
    ante el Congreso de los Diputados y en defender un caso ante el Tribunal Supremo."
  canvasToShow: {fileID: 335874984}
  modalTextPages: {fileID: 335874982}
